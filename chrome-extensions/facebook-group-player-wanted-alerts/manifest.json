{
  "manifest_version": 3,
  "name": "Facebook Group: Player Wanted Alerts",
  "description": "Watches a Facebook group's chronological feed for NEW 'team needs players' posts and fires a loud, sticky desktop notification telling you the kick-off time and how many players are wanted.",
  "version": "1.1.0",
  "permissions": ["storage", "notifications", "alarms", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Player Wanted Alerts",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/groups/*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
